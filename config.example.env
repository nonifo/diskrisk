# Diskrisk — example config
# Copy to config.env (gitignored) or /etc/diskrisk/config.env
# Existing environment variables always win over this file.
#
#   cp config.example.env config.env
#   $EDITOR config.env
#   python3 smart_risk.py
#
# Or: DISKRISK_CONFIG=/path/to/config.env python3 smart_risk.py
#
# On Bagoly CT130 the live file is EnvironmentFile=/opt/bagoly-smart-risk/env
# (same keys). Restart bagoly-smart-risk.service after edits.

# ── Diskrisk service (smart_risk.py) ─────────────────────────
BESZEL_URL=http://127.0.0.1:8090
BESZEL_USER=admin@example.com
BESZEL_PASS=

# Optional: Scrutiny summary API (device_status by serial). Leave empty to skip.
SCRUTINY_URL=

SMART_RISK_LISTEN=0.0.0.0:8091
SMART_RISK_HISTORY=/var/lib/diskrisk/history.json
# Keep trend samples this many days (default 365). Max points per calendar day (default 2).
SMART_RISK_HISTORY_DAYS=365
SMART_RISK_HISTORY_PER_DAY=2
# Optional hard cap (default = DAYS × PER_DAY). Usually leave unset.
# SMART_RISK_HISTORY_SAMPLES=730
# Per-host topology JSON from topology_collect.py (ZFS / mergerfs / btrfs)
SMART_RISK_TOPOLOGY=/var/lib/diskrisk/topology

# ── Risk policy (hybrid / stats) ─────────────────────────────
# classic = pre-1.4 raw≥1 maps (safe default in code if unset)
# hybrid  = media / interface / advisory + scar windows below
# stats   = hybrid + smart_collect.py DevStat overlays
DISKRISK_RISK_ENGINE=classic

# UDMA_CRC / Command_Timeout: no increase for N days → historical scar (not a fault)
DISKRISK_INTERFACE_HISTORICAL_DAYS=14

# GrownDefect / Realloc: no increase for N days → historical scar (early-life OK)
# Pending / OfflineUnc are never demoted by this window.
# Use 14 until you have ≥30d of Diskrisk history; then 30 is a better default.
DISKRISK_MEDIA_SCAR_HISTORICAL_DAYS=30

# Optional smartctl -x -j overlays from smart_collect.py (engine=stats)
# DISKRISK_SMART_DIR=/var/lib/diskrisk/smart

# Branding directory (logos/favicons). Optional product label / home link.
SMART_RISK_BRANDING=./branding
DISKRISK_PRODUCT=Diskrisk
DISKRISK_BRAND_URL=
# Optional credit in page footer, e.g. bagoly.se → "bagoly.se · 2026 · Diskrisk · MIT"
# (no © mark). If empty, hostname is taken from DISKRISK_BRAND_URL when set.
DISKRISK_BRAND_FOOTER=
DISKRISK_LOGO=logo.svg

# ── diskinfo CLI (standalone; Diskrisk optional) ─────────────
# Leave SMART_RISK_URL empty for pure ZFS mirror tree.
# Set it (or run: diskinfo --risk) to enrich SMART/RISK columns.
# SMART_RISK_URL=http://127.0.0.1:8091/json

# Default ZFS pool when `diskinfo` is run without an argument.
# `tank` is the conventional example/pool name in FreeBSD/TrueNAS docs.
DISKINFO_POOL=tank
