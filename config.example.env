# Diskrisk — example config
# Copy to config.env (gitignored) or /etc/diskrisk/config.env
# Existing environment variables always win over this file.
#
#   cp config.example.env config.env
#   $EDITOR config.env
#   python3 smart_risk.py
#
# Or: DISKRISK_CONFIG=/path/to/config.env python3 smart_risk.py

# ── Diskrisk service (smart_risk.py) ─────────────────────────
BESZEL_URL=http://127.0.0.1:8090
BESZEL_USER=admin@example.com
BESZEL_PASS=

# Optional: Scrutiny summary API (device_status by serial). Leave empty to skip.
SCRUTINY_URL=

SMART_RISK_LISTEN=0.0.0.0:8091
SMART_RISK_HISTORY=/var/lib/diskrisk/history.json
SMART_RISK_HISTORY_SAMPLES=120
# Per-host topology JSON from topology_collect.py (ZFS / mergerfs / btrfs)
SMART_RISK_TOPOLOGY=/var/lib/diskrisk/topology

# Branding directory (logos/favicons). Optional product label / home link.
SMART_RISK_BRANDING=./branding
DISKRISK_PRODUCT=Diskrisk
DISKRISK_BRAND_URL=
DISKRISK_LOGO=logo.svg

# ── diskinfo CLI (standalone; Diskrisk optional) ─────────────
# Leave SMART_RISK_URL empty for pure ZFS mirror tree.
# Set it (or run: diskinfo --risk) to enrich SMART/RISK columns.
# SMART_RISK_URL=http://127.0.0.1:8091/json

# Default ZFS pool when `diskinfo` is run without an argument.
# `tank` is the conventional example/pool name in FreeBSD/TrueNAS docs.
DISKINFO_POOL=tank
